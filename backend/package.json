{
  "name": "hospital-management-backend",
  "version": "1.0.0",
  "description": "Hospital Management System Backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all",
    "db:create": "npx sequelize-cli db:create",
    "db:drop": "npx sequelize-cli db:drop",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "user:create": "node src/scripts/manageAdmin.js create",
    "user:list": "node src/scripts/manageAdmin.js list",
    "user:promote": "node src/scripts/manageAdmin.js promote",
    "user:reset-password": "node src/scripts/manageAdmin.js reset-password",
    "admin:create": "node src/scripts/manageAdmin.js create",
    "admin:list": "node src/scripts/manageAdmin.js list",
    "admin:promote": "node src/scripts/manageAdmin.js promote",
    "admin:reset-password": "node src/scripts/manageAdmin.js reset-password",
    "lint": "eslint src/",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0",
    "resend": "^6.32.1",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
