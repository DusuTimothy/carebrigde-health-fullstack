NODE_ENV=development
PORT=5000
CLIENT_URL

DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=

# Enables SQL query logging when "true"
DB_LOGGING=false

# SSL for hosted databases like Aiven (values: true|require|verify-ca|verify-full).
#   true / require    -> SSL without a custom CA
#   verify-ca / verify-full -> SSL using DATABASE_CA; this setting takes precedence over URL sslmode
DB_SSL=
DATABASE_CA=
TLS_KEY_SECRET=
