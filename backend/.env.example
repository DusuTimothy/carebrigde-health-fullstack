NODE_ENV=development
PORT=5000

# Public frontend origin, used to build verification / password-reset links.
# Example: https://app.example.com
CLIENT_URL=

# Transactional email (Brevo) — backend only, never expose to the frontend.
# BREVO_API_KEY: create at https://app.brevo.com/settings/keys/api (starts with "xkeysib-").
# EMAIL_FROM: a verified sender, e.g. "Carebridge Health <no-reply@yourdomain.com>".
# EMAIL_FROM_NAME: display name used when EMAIL_FROM is a bare address (optional).
# Leave blank in development to capture messages in the in-memory dev outbox
# instead of sending. Production refuses to send when these are missing.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# How long emailed links stay valid, in minutes (defaults: 60 / 60).
EMAIL_VERIFICATION_TTL_MINUTES=
PASSWORD_RESET_TTL_MINUTES=

DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=

# Comma-separated list of allowed browser origins
CORS_ORIGIN=

# Enables SQL query logging when "true"
DB_LOGGING=false

# SSL for hosted databases like Aiven (values: true|require|verify-ca|verify-full).
#   true / require    -> SSL without a custom CA
#   verify-ca / verify-full -> SSL using DATABASE_CA; this setting takes precedence over URL sslmode
DB_SSL=
DATABASE_CA=
TLS_KEY_SECRET=
