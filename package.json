{
  "name": "health-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "user:create": "npm --prefix backend run user:create --",
    "user:list": "npm --prefix backend run user:list",
    "user:promote": "npm --prefix backend run user:promote --",
    "user:reset-password": "npm --prefix backend run user:reset-password --",
    "admin:create": "npm --prefix backend run admin:create --",
    "admin:list": "npm --prefix backend run admin:list",
    "admin:promote": "npm --prefix backend run admin:promote --",
    "admin:reset-password": "npm --prefix backend run admin:reset-password --",
    "test": "npm --prefix backend run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
